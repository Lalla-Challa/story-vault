{
  "name": "story-vault",
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,electron \"npm:dev:server\" \"npm:dev:electron\"",
    "dev:server": "cross-env NODE_ENV=development node --watch --watch-path=server --import tsx server/_core/index.ts",
    "dev:electron": "electron-vite dev",
    "build": "npm run build:server && npm run build:electron && npm run build:mcp",
    "build:server": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:mcp": "esbuild server/mcpCli.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/mcp.js",
    "build:mcp:npm": "esbuild server/mcpCli.ts --platform=node --bundle --format=cjs --external:better-sqlite3-multiple-ciphers --external:@huggingface/transformers --outfile=mcp/npm/dist/server.cjs && node -e \"require('fs').copyFileSync('mcp/npm/launcher.cjs', 'mcp/npm/dist/index.cjs')\"",
    "build:ccm-index": "tsx scripts/build-ccm-index.ts",
    "test:ccm-guidance": "tsx server/ccm/guidance.test.ts",
    "build:electron": "electron-vite build",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:electron": "electron .",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "postinstall": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.99",
    "@ai-sdk/openai": "^2.0.122",
    "@ai-sdk/openai-compatible": "^2.0.73",
    "@hookform/resolvers": "^5.2.2",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-font-family": "^3.24.0",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-mention": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.24.0",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tiptap/suggestion": "^3.23.6",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "ai": "^6.0.271",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "embla-carousel-react": "^8.6.0",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "multer": "^2.1.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.18.0",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.64.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "streamdown": "^1.4.0",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tippy.js": "^6.3.7",
    "vaul": "^1.1.2",
    "wouter": "3.7.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "esbuild": "^0.25.0",
    "pnpm": "^10.15.1",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.7"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "better-sqlite3-multiple-ciphers",
      "electron",
      "@electron/rebuild",
      "esbuild"
    ],
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    }
  },
  "build": {
    "appId": "dev.story-vault.app",
    "productName": "Story Vault",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "out/**/*",
      "dist/client/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle"
      },
      {
        "from": "server/ccm/ccm-index.json",
        "to": "server/ccm/ccm-index.json"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "description": "AI infrastructure for narrative canon — a local-first, deterministic story-simulation engine (CCE) that owns canon; the LLM only renders prose or proposes validated changes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lalla-Challa/story-vault.git"
  },
  "author": "Faisal Iqbal",
  "keywords": [
    "ai",
    "narrative",
    "mcp",
    "llm",
    "world-model",
    "simulation",
    "writing",
    "electron",
    "story-engine"
  ],
  "engines": {}
}
